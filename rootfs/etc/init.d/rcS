#!/bin/sh

PATH=$PATH:/sbin:/bin:/usr/sbin:/usr/bin
LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/lib:/usr/lib
runlevel=S
umask 022
export PATH LD_LIBRARY_PATH runlevel

mount -a
mkdir /dev/pts
mount -t devpts devpts /dev/pts

echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

cd /usr/bin
./lcd_always_on
cd ..

vsftpd &
/sbin/sshd &

if [ -f "/var/lib/alsa/asound.state" ]; then
        echo "ALSA: Restoring mixer setting......"
        /sbin/alsactl -f /var/lib/alsa/asound.state restore &
fi

/sbin/ip link set can0 up type can bitrate 500000

insmod /lib/modules/4.1.15/flexcan_dma.ko

ifconfig can0 up

# 设置库路径
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib:/app/lib

# 启动 CAN 服务
echo "Starting CAN Service..."
/usr/local/bin/can_service > /var/log/can_service.log 2>&1 &
sleep 2  # 等待 CAN 服务初始化

# 启动车辆系统应用
echo "Starting vehicle system applications..."

# 启动动力系统
/app/brake_system/powertrain > /var/log/powertrain.log 2>&1 &

# 启动仪表盘
/app/dashboard/dashboard > /var/log/dashboard.log 2>&1 &

echo "Vehicle system applications started"

