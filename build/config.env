# 开发板配置
export BOARD="imx6ull-mini"
export DTB="imx6ull-alientek-emmc.dtb"

# 网络配置
export NFS_ROOT="/srv/nfs/$BOARD"
export TFTP_ROOT="/srv/tftp"

# 编译选项
export KERNEL_CONFIG="imx_alientek_emmc_defconfig"
export UBOOT_CONFIG="mx6ull_alientek_emmc_defconfig"

# 高级选项
export CCACHE_ENABLED=1
export MODULE_SIGNING=0
