# config.env
# 交叉编译工具链路径
export TOOLCHAIN_DIR="${PWD}/toolchains/gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabihf"
export PATH="${TOOLCHAIN_DIR}/bin:${PATH}"

# 内核源码路径
export KERNEL_DIR="$PROJECT_ROOT/kernel/linux-imx-rel_imx_4.1.15_2.1.0_ga_alientek"

# 模块输出目录（NFS根文件系统路径）
export NFS_ROOTFS="${PWD}/../rootfs"


# 根目录
export INCLUDE_DIR="$PROJECT_ROOT/transport/include"
